# 운영(EC2) 환경 변수 템플릿.
# 실제 값은 GitHub 저장소 Secret `PROD_ENV`에 이 형식 그대로 넣는다. 배포 시 EC2의 /opt/devlink/.env 로 기록된다.
# 이 파일에는 실제 비밀번호를 적지 않는다.
# DB_URL은 deploy/docker-compose.prod.yml(같은 폴더)이 postgres 컨테이너 주소로 고정하므로 여기 없다.
# 변수를 추가할 때: 1) 이 파일에 키 추가 → 2) Secret PROD_ENV에 값 추가 → 3) docker-compose.prod.yml app.environment에 전달 추가
# 선택 설정. 기본값 false로 기존 CLI를 허용한다.
# 모든 CLI 업데이트 완료 후 PROD_ENV에 true로 추가한다.
# WORKING_FILES_REQUIRE_IF_MATCH=false

DB_USERNAME=devlink
DB_PASSWORD=change-me
WS_ALLOWED_ORIGINS=https://frontend.example.com
# cursor 검증용 32바이트 이상 무작위 값. 실제 값은 PROD_ENV에만 저장한다.
TASK_MESSAGE_CURSOR_SECRET=

# 팀·파트 Context를 OpenRouter로 요약하려면 아래 네 줄을 PROD_ENV에 추가한다.
# 선택 설정이므로 템플릿에서는 주석으로 두고 배포의 필수 키 검사에서 제외한다.
# 서버는 UPSTAGE_API_KEY에서 OpenRouter 키를 읽는다. 키가 없으면 구조 신호만 반영한다.
# UPSTAGE_API_KEY=
# TEAM_CONTEXT_INFERENCE_BASE_URL=https://openrouter.ai/api/v1
# TEAM_CONTEXT_INFERENCE_MODEL=openai/gpt-4o-mini
# TEAM_CONTEXT_INFERENCE_OPENROUTER_GUARD=true

# 담당 Agent 추천의 역할 태그 판정에 결정 모델을 쓰려면 아래 두 줄을 PROD_ENV에 추가한다. 키는 OpenRouter 키다.
# 선택 설정이므로 템플릿에서는 주석으로 두고 배포의 필수 키 검사에서 제외한다.
# 켜면 질문과 팀원의 명시 역할 태그가 OpenRouter를 거쳐 모델 제공자(기본 모델은 Google)로 전송되고 추천 요청마다 유료 호출이 한 번 생긴다.
# 키가 없거나 호출이 실패하면 기존 토큰 일치만 쓴다. 자세한 내용은 docs/agent-recommendation.md 참조.
# DECISION_MODEL_ENABLED=true
# DECISION_MODEL_API_KEY=
# 필요할 때만 조정한다. 기본값은 1500(ms, 최대 2000)과 0.7이다.
# DECISION_MODEL_TIMEOUT_MS=1500
# DECISION_MODEL_THRESHOLD=0.7
# 같은 요청 형식을 받는 자체 호스팅 서버를 쓸 때만 바꾼다. 키가 없으면 REQUIRE_API_KEY=false로 둔다.
# DECISION_MODEL_URL=https://openrouter.ai/api/alpha/decisions
# DECISION_MODEL_MODEL=google/gemini-decision-1
# DECISION_MODEL_REQUIRE_API_KEY=true
