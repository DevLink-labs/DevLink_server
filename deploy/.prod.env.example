# 운영(EC2) 환경 변수 템플릿.
# 실제 값은 GitHub 저장소 Secret `PROD_ENV`에 이 형식 그대로 넣는다. 배포 시 EC2의 /opt/devlink/.env 로 기록된다.
# 이 파일에는 실제 비밀번호를 적지 않는다.
# DB_URL은 deploy/docker-compose.prod.yml(같은 폴더)이 postgres 컨테이너 주소로 고정하므로 여기 없다.
# 변수를 추가할 때: 1) 이 파일에 키 추가 → 2) Secret PROD_ENV에 값 추가 → 3) docker-compose.prod.yml app.environment에 전달 추가
# 선택 설정. 기본값 false로 기존 CLI를 허용한다.
# 모든 CLI 업데이트 완료 후 PROD_ENV에 true로 추가한다.
# WORKING_FILES_REQUIRE_IF_MATCH=false

DB_USERNAME=devlink
DB_PASSWORD=change-me
WS_ALLOWED_ORIGINS=https://frontend.example.com
# cursor 검증용 32바이트 이상 무작위 값. 실제 값은 PROD_ENV에만 저장한다.
TASK_MESSAGE_CURSOR_SECRET=
