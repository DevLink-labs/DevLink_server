# 운영(EC2) 환경 변수 템플릿.
# 실제 값은 GitHub 저장소 Secret `PROD_ENV`에 이 형식 그대로 넣는다. 배포 시 EC2의 /opt/devlink/.env 로 기록된다.
# 이 파일에는 실제 비밀번호를 적지 않는다.
# DB_URL은 deploy/docker-compose.prod.yml(같은 폴더)이 postgres 컨테이너 주소로 고정하므로 여기 없다.
# 변수를 추가할 때: 1) 이 파일에 키 추가 → 2) Secret PROD_ENV에 값 추가 → 3) docker-compose.prod.yml app.environment에 전달 추가
# 선택 설정. 기본값 false로 기존 CLI를 허용한다.
# 모든 CLI 업데이트 완료 후 PROD_ENV에 true로 추가한다.
# WORKING_FILES_REQUIRE_IF_MATCH=false

DB_USERNAME=devlink
DB_PASSWORD=change-me
WS_ALLOWED_ORIGINS=https://frontend.example.com
# cursor 검증용 32바이트 이상 무작위 값. 실제 값은 PROD_ENV에만 저장한다.
TASK_MESSAGE_CURSOR_SECRET=

# 팀·파트 Context를 LLM으로 요약하려면 아래 한 줄을 PROD_ENV에 추가한다. 기본 대상은 OpenRouter의 openai/gpt-6-luna다.
# 선택 설정이므로 템플릿에서는 주석으로 두고 배포의 필수 키 검사에서 제외한다. 키가 없으면 구조 신호만 반영한다.
# OPENROUTER_API_KEY=
# 이전 이름 UPSTAGE_API_KEY는 더 이상 읽지 않는다. 그 이름으로 OpenRouter 키를 둔 배포는 같은 값을 OPENROUTER_API_KEY로 옮긴다.
# 옮기지 않아도 배포는 성공하고 요약만 구조 신호 전용이 된다. 배포 전에 OPENROUTER_API_KEY를 먼저 추가하고 배포 뒤에 이전 이름을 지운다.
# 키는 주소와 짝이 맞아야 한다. OpenRouter 주소에 OpenRouter 키 형식(sk-or-)이 아닌 키를 두거나, 다른 주소에 OpenRouter 키를 두면
# 그 키를 보내지 않고 구조 신호 전용으로 동작한다(시작 로그에 경고).
# 모델을 바꾸거나 자체 호스팅 서버를 쓸 때만 아래를 추가한다.
# 예: OpenRouter의 다른 모델로 바꾸기(모델 비교는 docs/team-context.md의 "기본 모델 선택" 참조)
# TEAM_CONTEXT_INFERENCE_MODEL=openai/gpt-4o-mini
# 예: 키 없는 자체 vLLM(OPENROUTER_API_KEY는 지운다)
# TEAM_CONTEXT_INFERENCE_BASE_URL=http://vllm.internal:8000/v1
# TEAM_CONTEXT_INFERENCE_MODEL=<서버가 제공하는 모델 이름>
# TEAM_CONTEXT_INFERENCE_REQUIRE_API_KEY=false
# OpenRouter 앞에 프록시를 두면 제공자 필터를 명시한다(기본 auto는 주소가 openrouter.ai일 때만 적용).
# TEAM_CONTEXT_INFERENCE_OPENROUTER_GUARD=true
# 로그에 "cut off at max_tokens"가 보이면 출력 토큰 한도를 올린다(기본 6000).
# TEAM_CONTEXT_INFERENCE_MAX_OUTPUT_TOKENS=6000
